# Puerto del servidor Express
PORT=3002

# OpenWeather API — opcional
# Si está vacío, el servicio devuelve datos mockeados (útil para dev sin key)
# Obtén una key gratuita en: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Ollama — endpoint donde corre el LLM local
OLLAMA_HOST=http://localhost:11434
