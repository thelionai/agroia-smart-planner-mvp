# ─── Base de datos ───────────────────────────────────────────────
# Desarrollo local con SQLite (sin instalación, archivo único):
DATABASE_URL=sqlite:///./agroia.db

# Desarrollo con Postgres local:
# DATABASE_URL=postgresql://agroia:agroia_dev@localhost:5432/agroia_db

# Producción (Render / Railway / Neon / Supabase):
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/agroia_db

# ─── Seguridad JWT ───────────────────────────────────────────────
# Generar uno seguro con: openssl rand -hex 32
# NUNCA usar este valor de ejemplo en producción.
SECRET_KEY=cambia_esto_por_una_clave_segura_de_minimo_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Entorno ─────────────────────────────────────────────────────
# Valores: development | test | production
ENVIRONMENT=development

# ─── API Climática ───────────────────────────────────────────────
# Open-Meteo es gratuita y no requiere API key.
# Alternativas futuras: nasa-power (también gratuita)
CLIMA_API=open-meteo

# ─── IA Gemini ───────────────────────────────────────────────────
# Opcional. Si está vacío, ai_service.py devuelve respuestas simuladas.
# Obtener key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
